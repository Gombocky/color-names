imedia.org/wikipedia/commons/thumb/9/9c/Ballet_1582.png/500px-Ballet_1582.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Ballet_1582.png/500px-Ballet_1582.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The Ballet Comique de la Reine, from an engraving of 1582 by Jacques Patin","link":"https://en.wikipedia.org/wiki/File%3ABallet_1582.png"}],"sounds":{"magnificence":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/c/cf/En-us-magnificence.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cf/En-us-magnificence.ogg/En-us-magnificence.ogg.mp3"}]}}}