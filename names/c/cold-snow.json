.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Tanglanglapass.jpg/500px-Tanglanglapass.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Tanglanglapass.jpg/250px-Tanglanglapass.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3ATanglanglapass.jpg"}],"sounds":{"cold":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/9/9a/En-uk-cold.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9a/En-uk-cold.ogg/En-uk-cold.ogg.mp3"},{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1860_%28eng%29-Back_ache-cold.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bc/LL-Q1860_%28eng%29-Back_ache-cold.wav/LL-Q1860_%28eng%29-Back_ache-cold.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bc/LL-Q1860_%28eng%29-Back_ache-cold.wav/LL-Q1860_%28eng%29-Back_ache-cold.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/b/bf/En-us-cold.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/En-us-cold.ogg/En-us-cold.ogg.mp3"}],"snow":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/9/96/En-uk-snow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/96/En-uk-snow.ogg/En-u