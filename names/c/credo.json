{"name":"Credo","hex":"#dcba42","fetched":"2026-10-12","looked":{"definitions":[{"term":"credo","whole":true,"parts":[{"part":"Noun","definitions":["A statement of a belief or a summary statement of a whole belief system; also (metonymically) the belief or belief system itself.","The liturgical creed (usually the Nicene Creed), or a musical arrangement of it for use in church services."]}],"link":"https://en.wiktionary.org/wiki/credo"}],"entries":[{"title":"Credo","blocks":[{"text":"In Christian liturgy, the credo is the portion of the Mass where a creed is recited or sung. The Nicene-Constantinopolitan Creed or the Apostles' Creed are the primary creeds used for this purpose."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Bwv232-credo.jpg/330px-Bwv232-credo.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Credo"},{"title":"Credo (Penderecki)","blocks":[{"text":"Credo is a large-scale sacred composition for soloists, children's choir, mixed choir and orchestra by Krzysztof Penderecki, completed in 1998. It was commissioned by Helmuth Rilling for the Oregon Bach Festival, where it was first performed on 11 July 1998. Penderecki expanded the liturgical text by hymns and Bible verses in Latin, Polish and German. A recording won the 2000 Grammy Award for best choral performance."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Krzysztof_Penderecki_20080706.jpg/330px-Krzysztof_Penderecki_20080706.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Credo_(Penderecki)"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Credo_III.jpg/500px-Credo_III.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Credo_III.jpg/1280px-Credo_III.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Credo_III.jpg/500px-Credo_III.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Credo III in The Liber Usualis","link":"https://en.wikipedia.org/wiki/File%3ACredo_III.jpg"}],"sounds":{"credo":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q1860_%28eng%29-Vealhurl-credo.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/eb/LL-Q1860_%28eng%29-Vealhurl-credo.wav/LL-Q1860_%28eng%29-Vealhurl-credo.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/eb/LL-Q1860_%28eng%29-Vealhurl-credo.wav/LL-Q1860_%28eng%29-Vealhurl-credo.wav.ogg"},{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1860_%28eng%29-Vealhurl-credo2.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/LL-Q1860_%28eng%29-Vealhurl-credo2.wav/LL-Q1860_%28eng%29-Vealhurl-credo2.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/LL-Q1860_%28eng%29-Vealhurl-credo2.wav/LL-Q1860_%28eng%29-Vealhurl-credo2.wav.ogg"}]}}}