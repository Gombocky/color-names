 orange named after the fruit of the same name."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/TangerineFruit.jpg/330px-TangerineFruit.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Tangerine_(color)"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Sweet_Baby_Kisses_Family_Love.jpg/500px-Sweet_Baby_Kisses_Family_Love.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Sweet_Baby_Kisses_Family_Love.jpg/1280px-Sweet_Baby_Kisses_Family_Love.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Sweet_Baby_Kisses_Family_Love.jpg/500px-Sweet_Baby_Kisses_Family_Love.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Woman kissing a baby on the cheek","link":"https://en.wikipedia.org/wiki/File%3ASweet_Baby_Kisses_Family_Love.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/My_Grandfather_Photo_from_January_17.JPG/500px-My_Grandfather_Photo_from_January_17.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/My_Grandfather_Photo_from_January_17.JPG/1280px-My_Grandfather_Photo_from_January_17.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/My_Grandfather_Photo_from_January_17.JPG/500px-My_Grandfather_Photo_from_January_17.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A 93-year-old man from Pichilemu, Chile","link":"https://en.wikipedia.org/wiki/File%3AMy_Grandfather_Photo_from_January_17.JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/US_Navy_110527-N-OA833-014_Newly_commissioned_Navy_and_Marine_Corps_off