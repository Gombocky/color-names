{"name":"Decanter","hex":"#ada3bb","fetched":"2026-10-12","looked":{"definitions":[{"term":"decanter","whole":true,"parts":[{"part":"Noun","definitions":["A vessel for decanting liquor.","A receptacle for decanted liquor, especially a crystal bottle with a stopper."]}],"link":"https://en.wiktionary.org/wiki/decanter"}],"entries":[{"title":"Decanter","blocks":[{"text":"A decanter is a vessel that is used to hold the decantation of a liquid which may contain sediment. Decanters, which have a varied shape and design, have been traditionally made from glass or crystal. Their volume is usually equivalent to one standard bottle of wine."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Decanter_and_Stopper_LACMA_56.35.30a-b.jpg/330px-Decanter_and_Stopper_LACMA_56.35.30a-b.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Decanter"},{"title":"Decanter (magazine)","blocks":[{"text":"Decanter is a wine and wine-lifestyle media brand owned by Future plc. It includes a print and digital magazine, fine wine tasting events, a news website, a subscription website – Decanter Premium, and the Decanter World Wine Awards. The magazine, published in about 90 countries on a monthly basis, includes industry news, vintage guides and wine and spirits recommendations."}],"image":"https://upload.wikimedia.org/wikipedia/en/1/19/Decanter_August_2024_cover.webp?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","link":"https://en.wikipedia.org/wiki/Decanter_(magazine)"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Carafe_Iran.JPG/500px-Carafe_Iran.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Carafe_Iran.JPG/500px-Carafe_Iran.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Free-blown, wheel-cut carafes. First half of 11th century. Excavated at Teppe Madraseh, Neishapur, Iran. New York Metropolitan Museum of Art.","link":"https://en.wikipedia.org/wiki/File%3ACarafe_Iran.JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Dekantiermaschine.jpg/500px-Dekantiermaschine.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Dekantiermaschine.jpg/1280px-Dekantiermaschine.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Dekantiermaschine.jpg/500px-Dekantiermaschine.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A decanting machine","link":"https://en.wikipedia.org/wiki/File%3ADekantiermaschine.jpg"}],"sounds":{"decanter":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q1860_%28eng%29-Vininn126-decanter.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/LL-Q1860_%28eng%29-Vininn126-decanter.wav/LL-Q1860_%28eng%29-Vininn126-decanter.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/LL-Q1860_%28eng%29-Vininn126-decanter.wav/LL-Q1860_%28eng%29-Vininn126-decanter.wav.ogg"}]}}}