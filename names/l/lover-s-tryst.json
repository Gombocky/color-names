{"name":"Lover’s Tryst","hex":"#b48ca3","fetched":"2026-10-12","looked":{"definitions":[{"term":"lover","whole":false,"parts":[{"part":"Noun","definitions":["One who loves and cares for another person in a romantic way; a sweetheart, love, soulmate, boyfriend, girlfriend, or spouse.","A sexual partner, especially one with whom someone is having an affair."]},{"part":"Noun","definitions":["Obsolete form of louver."]}],"link":"https://en.wiktionary.org/wiki/lover"},{"term":"tryst","whole":false,"parts":[{"part":"Noun","definitions":["A prearranged meeting or assignation, now especially between lovers to meet at a specific place and time.","A mutual agreement, a covenant."]},{"part":"Verb","definitions":["To make a tryst; to agree to meet at a place.","To arrange or appoint (a meeting time etc.)."]}],"link":"https://en.wiktionary.org/wiki/tryst"}],"entries":[],"images":[],"sounds":{"lover":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/1/17/En-us-lover.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/En-us-lover.ogg/En-us-lover.ogg.mp3"}],"tryst":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/f/fa/En-us-tryst.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fa/En-us-tryst.ogg/En-us-tryst.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/6/63/En-au-tryst.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/63/En-au-tryst.ogg/En-au-tryst.ogg.mp3"}]}}}