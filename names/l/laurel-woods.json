{"name":"Laurel Woods","hex":"#44493d","fetched":"2026-10-12","looked":{"definitions":[{"term":"laurel","whole":false,"parts":[{"part":"Noun","definitions":["An evergreen shrub of species Laurus nobilis, having aromatic leaves of a lanceolate shape, with clusters of small, yellowish white flowers in their axils.","A crown of laurel."]},{"part":"Verb","definitions":["To decorate with laurel, especially with a laurel wreath.","To enwreathe."]}],"link":"https://en.wiktionary.org/wiki/laurel"},{"term":"woods","whole":false,"parts":[{"part":"Noun","definitions":["plural of wood"]},{"part":"Noun","definitions":["A dense collection of trees, usually one covering a relatively small area; usually smaller than a forest.","For chemical behavior purposes, trees in full leaf (coniferous or medium-dense deciduous forests)."]}],"link":"https://en.wiktionary.org/wiki/woods"}],"entries":[],"images":[],"sounds":{"laurel":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/38/En-us-laurel.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/En-us-laurel.ogg/En-us-laurel.ogg.mp3"}],"woods":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/2/22/En-us-woods.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/En-us-woods.ogg/En-us-woods.ogg.mp3"}]}}}