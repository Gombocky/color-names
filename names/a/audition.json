ier_Dancers_01.jpg/500px-Brazier_Dancers_01.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Brazier_Dancers_01.jpg/1280px-Brazier_Dancers_01.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Brazier_Dancers_01.jpg/500px-Brazier_Dancers_01.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"These dancers from the Braziers troupe are performing Highland dancing, a style at which auditionees must demonstrate a high degree of technique and the ability to quickly learn new steps.","link":"https://en.wikipedia.org/wiki/File%3ABrazier_Dancers_01.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Acrobat.jpg/500px-Acrobat.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Acrobat.jpg/1280px-Acrobat.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Acrobat.jpg/500px-Acrobat.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A high wire act by an acrobat","link":"https://en.wikipedia.org/wiki/File%3AAcrobat.jpg"}],"sounds":{"audition":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1860_%28eng%29-Vealhurl-audition.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/LL-Q1860_%28eng%29-Vealhurl-audition.wav/LL-Q1860_%28eng%29-Vealhurl-audition.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/LL-Q1860_%28eng%29-Vealhurl-audition.wav/LL-Q1860_%28eng%29-Vealhurl-audition.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://u