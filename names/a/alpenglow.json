{"name":"Alpenglow","hex":"#f0beb8","fetched":"2026-10-11","looked":{"definitions":[{"term":"alpenglow","whole":true,"parts":[{"part":"Noun","definitions":["A rosy or reddish glow seen during sunset or sunrise on the summits of mountains, especially snow-covered mountains on the opposite side of the sun."]}],"link":"https://en.wiktionary.org/wiki/alpenglow"}],"entries":[{"title":"Alpenglow","blocks":[{"text":"Alpenglow is an optical phenomenon that appears as a horizontal reddish glow near the horizon opposite to the Sun when the solar disk is just below the horizon."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Alpenglow1a.jpg/330px-Alpenglow1a.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Alpenglow"}],"images":[],"sounds":{"alpenglow":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1860_%28eng%29-Persent101-alpenglow.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/90/LL-Q1860_%28eng%29-Persent101-alpenglow.wav/LL-Q1860_%28eng%29-Persent101-alpenglow.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/90/LL-Q1860_%28eng%29-Persent101-alpenglow.wav/LL-Q1860_%28eng%29-Persent101-alpenglow.wav.ogg"},{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1860_%28eng%29-Vealhurl-alpenglow.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/LL-Q1860_%28eng%29-Vealhurl-alpenglow.wav/LL-Q1860_%28eng%29-Vealhurl-alpenglow.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/LL-Q1860_%28eng%29-Vealhurl-alpenglow.wav/LL-Q1860_%28eng%29-Vealhurl-alpenglow.wav.ogg"}]}}}