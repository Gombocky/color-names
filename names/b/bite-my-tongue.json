c":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/78/LL-Q1860_%28eng%29-Naomi_Persephone_Amethyst_%28NaomiAmethyst%29-bite.wav/LL-Q1860_%28eng%29-Naomi_Persephone_Amethyst_%28NaomiAmethyst%29-bite.wav.ogg"}],"tongue":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/3c/En-uk-tongue.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/En-uk-tongue.ogg/En-uk-tongue.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/5/5c/En-us-tongue.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5c/En-us-tongue.ogg/En-us-tongue.ogg.mp3"}]},"pictures":[{"title":"Silhouette of an island at dusk with blue and pink clouds in Don Det Si Phan Don Laos","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Silhouette_of_an_island_at_dusk_with_blue_and_pink_clouds_in_Don_Det_Si_Phan_Don_Laos.jpg/500px-Silhouette_of_an_island_at_dusk_with_blue_and_pink_clouds_in_Don_Det_Si_Phan_Don_Laos.jpg","ratio":1.5998402555910542,"link":"https://commons.wikimedia.org/wiki/File:Silhouette_of_an_island_at_dusk_with_blue_and_pink_clouds_in_Don_Det_Si_Phan_Don_Laos.jpg","share":0.071875},{"title":"Pink 2006","image":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Pink_2006.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","ratio":0.7339449541284404,"link":"https://commons.wikimedia.org/wiki/File:Pink_2006.jpg","share":0.056875}]}}